# ==========================================
# Variables de Entorno de Ejemplo
# ==========================================

# Base de Datos
DB_HOST=127.0.0.1
DB_NOMBRE=odontologia_local
DB_USUARIO=root
DB_CLAVE=

# Modo Desarrollo (true = correos simulados en pantalla / false = envío SMTP real)
MODO_DEV=true

# Google Cloud OAuth 2.0
# Obtenidos en https://console.cloud.google.com -> APIs y Servicios -> Credenciales
GOOGLE_CLIENT_ID=tu-cliente-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=tu-client-secret-aqui

# Configuración SMTP (Opcional, para envío de correos reales)
SMTP_HOST=smtp.gmail.com
SMTP_PUERTO=587
SMTP_SEGURIDAD=tls
SMTP_USUARIO=tu-correo@gmail.com
SMTP_CLAVE=tu-contrasena-de-aplicacion-16-letras
